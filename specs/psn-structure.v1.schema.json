{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psn-structure:v1",
  "title": "Stable PSN structure (offline; no deployment identity)",
  "type": "object",
  "properties": {
    "format": {
      "const": "psn-structure/v1"
    },
    "process": {
      "$ref": "#/$defs/process"
    }
  },
  "required": [
    "format",
    "process"
  ],
  "additionalProperties": false,
  "$defs": {
    "process": {
      "type": "object",
      "properties": {
        "key": {
          "const": "DELIVERY"
        },
        "family": {
          "const": "DELIVERY"
        },
        "level": {
          "const": "PROCESS"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "PAUSED"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/phase"
              },
              {
                "properties": {
                  "id": {
                    "enum": [
                      "I1",
                      "T1",
                      "A1",
                      "D1",
                      "S1",
                      "H1",
                      "E1"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 7,
          "maxItems": 7
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflow"
          },
          "minItems": 1
        },
        "fail_exits": {
          "$ref": "#/$defs/step_list"
        },
        "raw_fetch_steps": {
          "$ref": "#/$defs/step_list"
        },
        "gates_pending_number": {
          "$ref": "#/$defs/pending_gates"
        },
        "node_types": {
          "$ref": "#/$defs/node_types"
        }
      },
      "required": [
        "key",
        "family",
        "level",
        "status",
        "name",
        "phases",
        "workflows"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z]+(\\.[a-z0-9-]+)?$",
          "anyOf": [
            {
              "enum": [
                "TARGET",
                "DISPATCH",
                "HANDLE"
              ]
            },
            {
              "pattern": "^SOLUTION\\.[a-z0-9-]+$"
            },
            {
              "pattern": "^KNOWLEDGE\\.[a-z0-9-]+$"
            },
            {
              "pattern": "^FETCH\\.[a-z0-9-]+$"
            }
          ]
        },
        "family": {
          "enum": [
            "TARGET",
            "DISPATCH",
            "SOLUTION",
            "HANDLE",
            "KNOWLEDGE",
            "FETCH"
          ]
        },
        "level": {
          "const": "WORKFLOW"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "PAUSED"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "fail_exits": {
          "$ref": "#/$defs/step_list"
        },
        "raw_fetch_steps": {
          "$ref": "#/$defs/step_list"
        },
        "gates_pending_number": {
          "$ref": "#/$defs/pending_gates"
        },
        "node_types": {
          "$ref": "#/$defs/node_types"
        }
      },
      "required": [
        "key",
        "family",
        "level",
        "status",
        "name",
        "phases"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "TARGET"
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "id": {
                      "enum": [
                        "T1"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "DISPATCH"
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "properties": {
                    "id": {
                      "enum": [
                        "A1",
                        "D1"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "SOLUTION"
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "properties": {
                    "id": {
                      "enum": [
                        "P1",
                        "P2",
                        "P3",
                        "P4",
                        "P5"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "HANDLE"
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "properties": {
                    "id": {
                      "enum": [
                        "P6",
                        "P7"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "KNOWLEDGE"
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "properties": {
                    "id": {
                      "enum": [
                        "Q1",
                        "Q2",
                        "Q3",
                        "Q4"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "FETCH"
              }
            }
          },
          "then": {
            "properties": {
              "phases": {
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "properties": {
                    "id": {
                      "enum": [
                        "F1",
                        "F2",
                        "F3"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "TARGET"
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "family": {
                "const": "TARGET"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "DISPATCH"
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "family": {
                "const": "DISPATCH"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "pattern": "^SOLUTION\\."
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "family": {
                "const": "SOLUTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "pattern": "^KNOWLEDGE\\."
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "family": {
                "const": "KNOWLEDGE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "pattern": "^FETCH\\."
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "family": {
                "const": "FETCH"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "HANDLE"
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "family": {
                "const": "HANDLE"
              }
            }
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][1-9][0-9]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "io": {
          "$ref": "#/$defs/phase_io"
        }
      },
      "required": [
        "id",
        "name",
        "steps"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][1-9][0-9]*\\.S[1-9][0-9]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "id",
        "name",
        "nodes"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "node_key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]+(\\.[a-z0-9-]+)?/[A-Z][1-9][0-9]*\\.S[1-9][0-9]*\\.N[1-9][0-9]*$"
        },
        "kind": {
          "enum": [
            "DECISION",
            "CALL",
            "TOOL",
            "TRANSFORM",
            "QUERY",
            "MODEL",
            "JOIN",
            "LOOP",
            "GATE",
            "EVENT"
          ]
        },
        "type": {
          "enum": [
            "READ",
            "DECIDE",
            "UNDERSTAND",
            "ACT",
            "EVENT",
            "WAIT",
            "CALL",
            "CONTROL"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "ACTIVE",
            "retired"
          ]
        },
        "retired_reason": {
          "type": "string",
          "minLength": 1
        },
        "moved_to": {
          "type": "string",
          "pattern": "^[A-Z]+(\\.[a-z0-9-]+)?/[A-Z][1-9][0-9]*\\.S[1-9][0-9]*\\.N[1-9][0-9]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node_key",
        "ref",
        "kind",
        "order",
        "status",
        "name"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "retired"
              }
            }
          },
          "then": {
            "required": [
              "retired_reason"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "retired_reason"
                  ]
                },
                {
                  "required": [
                    "moved_to"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "step_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][1-9][0-9]*\\.S[1-9][0-9]*$"
      },
      "uniqueItems": true
    },
    "phase_io": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/io_input"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/io_output"
          }
        }
      },
      "required": [
        "inputs",
        "outputs"
      ],
      "additionalProperties": false
    },
    "io_var": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}\\.[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "io_input": {
      "type": "object",
      "properties": {
        "var": {
          "$ref": "#/$defs/io_var"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Z][1-9][0-9]*$"
        }
      },
      "required": [
        "var",
        "from"
      ],
      "additionalProperties": false
    },
    "io_output": {
      "type": "object",
      "properties": {
        "var": {
          "$ref": "#/$defs/io_var"
        },
        "shape": {
          "type": "string",
          "pattern": "^[a-z]+(\\[[a-z]+\\])? · \\S"
        },
        "max_length": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "var",
        "shape",
        "max_length"
      ],
      "additionalProperties": false
    },
    "pending_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "uniqueItems": true
    },
    "node_types": {
      "description": "DMN 2.0.108 §一「流程节点类型」的登记写法（插件定；协调 11-26 F3：照一份评审过的在用登记写法）。labels 是八类与类名，逐字照标准；control_values 是分支闸还认哪些控制值；code_stock 与 type_stock 是存量（只减不增，psn check --live 锚现网图）。",
      "type": "object",
      "properties": {
        "means": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "labels": {
          "const": {
            "READ": "读",
            "DECIDE": "判",
            "UNDERSTAND": "理解",
            "ACT": "动",
            "EVENT": "事件",
            "WAIT": "等人",
            "CALL": "调用",
            "CONTROL": "控制"
          }
        },
        "control_values": {
          "type": "object",
          "properties": {
            "means": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "operators": {
              "type": "array",
              "items": {
                "enum": [
                  "is",
                  "=",
                  "is not",
                  "≠"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "values": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                      },
                      "from": {
                        "const": "ROUND_ITEM"
                      }
                    },
                    "required": [
                      "key",
                      "from"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                      },
                      "from_node": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "key",
                      "from_node"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "values"
          ],
          "additionalProperties": false
        },
        "code_stock": {
          "type": "object",
          "properties": {
            "means": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "max": {
              "type": "integer",
              "minimum": 0
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "node_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "move_to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "node_key",
                  "move_to"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "max",
            "nodes"
          ],
          "additionalProperties": false
        },
        "type_stock": {
          "type": "object",
          "properties": {
            "means": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "node_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "code": {
                    "enum": [
                      "NODE_TYPE_MISSING",
                      "NODE_TYPE_TITLE_MISMATCH",
                      "NODE_TYPE_MISMATCH"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "DECIDE_OUTSIDE_PLUGIN",
                      "READ_OUTSIDE_CAPABILITY",
                      "ACT_OUTSIDE_DISPOSAL",
                      "UNDERSTAND_OFF_CATALOG",
                      "CONTROL_BUSINESS_TEST"
                    ]
                  },
                  "move_to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "node_key",
                  "code"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "reason"
                      ]
                    },
                    "then": {
                      "properties": {
                        "code": {
                          "const": "NODE_TYPE_MISMATCH"
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "nodes"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
