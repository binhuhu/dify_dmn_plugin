{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psn-check-report:v1",
  "title": "Result of checking one Dify graph against a psn-structure/v1 entry (offline)",
  "type": "object",
  "properties": {
    "format": {"const": "psn-check-report/v1"},
    "workflow": {"type": "string", "pattern": "^[A-Z]+(\\.[a-z0-9-]+)?$"},
    "strict": {"type": "boolean"},
    "ok": {"type": "boolean"},
    "result": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "graph_nodes": {"type": "integer", "minimum": 0},
    "node_types": {"enum": ["TYPED", "UNDECLARED"]},
    "stock_source": {"enum": ["entry", "list", "off_list"]},
    "node_type_counts": {
      "type": "object",
      "propertyNames": {
        "enum": ["READ", "DECIDE", "UNDERSTAND", "ACT", "EVENT", "WAIT", "CALL", "CONTROL", "CODE", "UNDECLARED"]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nodes": {"type": "integer", "minimum": 1},
          "pass": {"type": "integer", "minimum": 0},
          "unverified": {"type": "integer", "minimum": 0},
          "stock": {"type": "integer", "minimum": 0},
          "fail": {"type": "integer", "minimum": 0}
        },
        "required": ["nodes", "pass", "unverified", "stock", "fail"],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z_]+$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "UNPLACED_NODE",
              "RETIRED_NODE_IN_GRAPH",
              "MISSING_NODE",
              "KIND_MISMATCH",
              "UNKNOWN_NODE_TYPE",
              "NODE_REF_MISSING",
              "NODE_REF_MISMATCH",
              "NODE_REF_UNRESOLVABLE",
              "FAIL_BRANCH_DANGLING",
              "NOT_STAMPED",
              "SILENT_DMN_DEFAULT",
              "DMN_STATUS_UNCHECKED",
              "MISPLACED_NODE",
              "WORKFLOW_CALL_FORBIDDEN",
              "DISPATCH_DECISION_COUNT",
              "NO_FAILURE_HANDLING",
              "SCENE_DEFINITION_IN_CODE",
              "SILENT_FETCH_DEFAULT",
              "PHASE_IO_UNDECLARED_OUTPUT",
              "PHASE_IO_UNDECLARED_INPUT",
              "PHASE_IO_UNUSED",
              "PHASE_IO_SHAPE",
              "FAILURE_SIGNAL_LEAK",
              "RAW_FETCH_LEAK",
              "NODE_TYPE_MISSING",
              "NODE_TYPE_TITLE_MISMATCH",
              "NODE_TYPE_MISMATCH",
              "NODE_CODE_NOT_ALLOWED",
              "NODE_TYPE_UNVERIFIED",
              "NODE_TYPE_STOCK_STALE",
              "NODE_TYPE_STOCK_GREW"
            ]
          },
          "severity": {"enum": ["FAIL", "WARN", "UNVERIFIED"]},
          "node_key": {"type": "string"},
          "ref": {"type": "string"},
          "message": {"type": "string"},
          "reason": {
            "enum": [
              "DECIDE_OUTSIDE_PLUGIN",
              "READ_OUTSIDE_CAPABILITY",
              "ACT_OUTSIDE_DISPOSAL",
              "UNDERSTAND_OFF_CATALOG",
              "CONTROL_BUSINESS_TEST"
            ]
          },
          "actual": {"enum": ["READ", "DECIDE", "UNDERSTAND", "ACT", "EVENT", "WAIT", "CALL", "CONTROL"]},
          "stock": {"const": true}
        },
        "required": ["code", "severity", "message"],
        "additionalProperties": false,
        "allOf": [
          {"if": {"required": ["reason"]}, "then": {"properties": {"code": {"const": "NODE_TYPE_MISMATCH"}}}},
          {"if": {"required": ["actual"]}, "then": {"properties": {"code": {"const": "NODE_TYPE_MISMATCH"}}}},
          {
            "if": {"properties": {"severity": {"const": "UNVERIFIED"}}},
            "then": {"properties": {"code": {"const": "NODE_TYPE_UNVERIFIED"}}}
          },
          {
            "if": {"required": ["stock"]},
            "then": {
              "properties": {
                "severity": {"const": "WARN"},
                "code": {
                  "enum": ["NODE_TYPE_MISSING", "NODE_TYPE_TITLE_MISMATCH", "NODE_TYPE_MISMATCH", "NODE_CODE_NOT_ALLOWED"]
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": ["format", "workflow", "strict", "ok", "result", "graph_nodes", "counts", "issues"],
  "additionalProperties": false
}
