<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="SyntheticDefinitions" name="SyntheticOnly" namespace="urn:synthetic:query-dmn-example">
<inputData id="i_lookup_outcome" name="lookup_outcome"><variable name="lookup_outcome" typeRef="Any"/></inputData>
<inputData id="i_scene_status" name="scene_status"><variable name="scene_status" typeRef="Any"/></inputData>
<inputData id="i_availability_fact" name="availability_fact"><variable name="availability_fact" typeRef="Any"/></inputData>
<inputData id="i_fact_order_id" name="fact_order_id"><variable name="fact_order_id" typeRef="Any"/></inputData>
<inputData id="i_queried_order_id" name="queried_order_id"><variable name="queried_order_id" typeRef="Any"/></inputData>
<inputData id="i_feature_state" name="feature_state"><variable name="feature_state" typeRef="Any"/></inputData>
<inputData id="i_conclusions" name="conclusions"><variable name="conclusions" typeRef="Any"/></inputData>
<inputData id="i_focal_conclusion" name="focal_conclusion"><variable name="focal_conclusion" typeRef="Any"/></inputData>
<inputData id="i_acceptance_status" name="acceptance_status"><variable name="acceptance_status" typeRef="Any"/></inputData>
<inputData id="i_strategy" name="strategy"><variable name="strategy" typeRef="Any"/></inputData>
<inputData id="i_compensation_status" name="compensation_status"><variable name="compensation_status" typeRef="Any"/></inputData>
<decision id="validate_scene" name="validate_scene"><variable name="validate_scene" typeRef="Any"/><informationRequirement><requiredInput href="#i_lookup_outcome"/></informationRequirement><decisionTable id="t_validate_scene" hitPolicy="UNIQUE"><input id="x1"><inputExpression typeRef="Any"><text>lookup_outcome</text></inputExpression></input><output id="x2" name="result" typeRef="Any"/><rule id="validate_scene_r1"><inputEntry id="x3"><text>&quot;FOUND&quot;</text></inputEntry><outputEntry id="x4"><text>&quot;VALID&quot;</text></outputEntry></rule><rule id="validate_scene_r2"><inputEntry id="x5"><text>&quot;NOT_FOUND&quot;</text></inputEntry><outputEntry id="x6"><text>&quot;NOT_ESTABLISHED&quot;</text></outputEntry></rule></decisionTable></decision>
<decision id="acceptance" name="acceptance"><variable name="acceptance" typeRef="Any"/><informationRequirement><requiredInput href="#i_scene_status"/></informationRequirement><decisionTable id="t_acceptance" hitPolicy="UNIQUE"><input id="x7"><inputExpression typeRef="Any"><text>scene_status</text></inputExpression></input><output id="x8" name="result" typeRef="Any"/><rule id="acceptance_r1"><inputEntry id="x9"><text>&quot;VALID&quot;</text></inputEntry><outputEntry id="x10"><text>&quot;ACCEPT&quot;</text></outputEntry></rule><rule id="acceptance_r2"><inputEntry id="x11"><text>&quot;NOT_ESTABLISHED&quot;</text></inputEntry><outputEntry id="x12"><text>&quot;MANUAL_REVIEW&quot;</text></outputEntry></rule></decisionTable></decision>
<decision id="compensation_limit" name="compensation_limit"><variable name="compensation_limit" typeRef="Any"/><informationRequirement><requiredInput href="#i_scene_status"/></informationRequirement><decisionTable id="t_compensation_limit" hitPolicy="UNIQUE"><input id="x13"><inputExpression typeRef="Any"><text>scene_status</text></inputExpression></input><output id="x14" name="result" typeRef="Any"/><rule id="compensation_limit_r1"><inputEntry id="x15"><text>-</text></inputEntry><outputEntry id="x16"><text>&quot;NO_COMPENSATION_AUTHORIZED&quot;</text></outputEntry></rule></decisionTable></decision>
<decision id="feature" name="feature"><variable name="feature" typeRef="Any"/><informationRequirement><requiredInput href="#i_availability_fact"/></informationRequirement><informationRequirement><requiredInput href="#i_fact_order_id"/></informationRequirement><informationRequirement><requiredInput href="#i_queried_order_id"/></informationRequirement><decisionTable id="t_feature" hitPolicy="UNIQUE"><input id="x17"><inputExpression typeRef="Any"><text>fact_order_id = queried_order_id</text></inputExpression></input><input id="x18"><inputExpression typeRef="Any"><text>availability_fact</text></inputExpression></input><output id="x19" name="result" typeRef="Any"/><rule id="feature_r1"><inputEntry id="x20"><text>true</text></inputEntry><inputEntry id="x21"><text>&quot;ABSENT&quot;</text></inputEntry><outputEntry id="x22"><text>&quot;SATISFIED&quot;</text></outputEntry></rule><rule id="feature_r2"><inputEntry id="x23"><text>true</text></inputEntry><inputEntry id="x24"><text>&quot;PRESENT&quot;</text></inputEntry><outputEntry id="x25"><text>&quot;NOT_SATISFIED&quot;</text></outputEntry></rule><rule id="feature_r3"><inputEntry id="x26"><text>true</text></inputEntry><inputEntry id="x27"><text>&quot;UNKNOWN&quot;</text></inputEntry><outputEntry id="x28"><text>&quot;UNKNOWN&quot;</text></outputEntry></rule><rule id="feature_r4"><inputEntry id="x29"><text>false</text></inputEntry><inputEntry id="x30"><text>-</text></inputEntry><outputEntry id="x31"><text>&quot;UNKNOWN&quot;</text></outputEntry></rule></decisionTable></decision>
<decision id="reality" name="reality"><variable name="reality" typeRef="Any"/><informationRequirement><requiredInput href="#i_feature_state"/></informationRequirement><decisionTable id="t_reality" hitPolicy="COLLECT"><input id="x32"><inputExpression typeRef="Any"><text>feature_state</text></inputExpression></input><output id="x33" name="result" typeRef="Any"/><rule id="reality_r1"><inputEntry id="x34"><text>&quot;SATISFIED&quot;</text></inputEntry><outputEntry id="x35"><text>&quot;CONFIRMED_ABSENT&quot;</text></outputEntry></rule><rule id="reality_r2"><inputEntry id="x36"><text>&quot;NOT_SATISFIED&quot;</text></inputEntry><outputEntry id="x37"><text>&quot;CONFIRMED_PRESENT&quot;</text></outputEntry></rule><rule id="reality_r3"><inputEntry id="x38"><text>&quot;UNKNOWN&quot;</text></inputEntry><outputEntry id="x39"><text>&quot;UNKNOWN&quot;</text></outputEntry></rule></decisionTable></decision>
<decision id="reality_priority" name="reality_priority"><variable name="reality_priority" typeRef="Any"/><informationRequirement><requiredInput href="#i_conclusions"/></informationRequirement><literalExpression><text>if list contains(conclusions, &quot;UNKNOWN&quot;) then &quot;UNKNOWN&quot; else if list contains(conclusions, &quot;CONFIRMED_ABSENT&quot;) then &quot;CONFIRMED_ABSENT&quot; else if list contains(conclusions, &quot;CONFIRMED_PRESENT&quot;) then &quot;CONFIRMED_PRESENT&quot; else &quot;UNKNOWN&quot;</text></literalExpression></decision>
<decision id="disposition" name="disposition"><variable name="disposition" typeRef="Any"/><informationRequirement><requiredInput href="#i_focal_conclusion"/></informationRequirement><informationRequirement><requiredInput href="#i_acceptance_status"/></informationRequirement><decisionTable id="t_disposition" hitPolicy="FIRST"><input id="x40"><inputExpression typeRef="Any"><text>acceptance_status</text></inputExpression></input><input id="x41"><inputExpression typeRef="Any"><text>focal_conclusion</text></inputExpression></input><output id="x42" name="result" typeRef="Any"/><rule id="disposition_r1"><inputEntry id="x43"><text>&quot;MANUAL_REVIEW&quot;</text></inputEntry><inputEntry id="x44"><text>-</text></inputEntry><outputEntry id="x45"><text>&quot;MANUAL_REVIEW&quot;</text></outputEntry></rule><rule id="disposition_r2"><inputEntry id="x46"><text>-</text></inputEntry><inputEntry id="x47"><text>&quot;UNKNOWN&quot;</text></inputEntry><outputEntry id="x48"><text>&quot;MANUAL_REVIEW&quot;</text></outputEntry></rule><rule id="disposition_r3"><inputEntry id="x49"><text>&quot;ACCEPT&quot;</text></inputEntry><inputEntry id="x50"><text>&quot;CONFIRMED_ABSENT&quot;</text></inputEntry><outputEntry id="x51"><text>&quot;CHECK_RECOVERY_OPTIONS&quot;</text></outputEntry></rule><rule id="disposition_r4"><inputEntry id="x52"><text>&quot;ACCEPT&quot;</text></inputEntry><inputEntry id="x53"><text>&quot;CONFIRMED_PRESENT&quot;</text></inputEntry><outputEntry id="x54"><text>&quot;EXPLAIN_CONFIRMED_STATE&quot;</text></outputEntry></rule></decisionTable></decision>
<decision id="action_advice" name="action_advice"><variable name="action_advice" typeRef="Any"/><informationRequirement><requiredInput href="#i_strategy"/></informationRequirement><informationRequirement><requiredInput href="#i_compensation_status"/></informationRequirement><literalExpression><text>if strategy = &quot;CHECK_RECOVERY_OPTIONS&quot; then [{recommendation_type:&quot;REVIEW_OPTIONS&quot;, capability_id:&quot;synthetic.unbound_action&quot;, binding_status:&quot;GAP&quot;, execution_mode:&quot;ADVISORY_ONLY&quot;, compensation_status:compensation_status}] else []</text></literalExpression></decision>
<decision id="ticket_advice" name="ticket_advice"><variable name="ticket_advice" typeRef="Any"/><informationRequirement><requiredInput href="#i_strategy"/></informationRequirement><literalExpression><text>[{recommendation_type:if strategy = &quot;MANUAL_REVIEW&quot; then &quot;REFER_TO_HUMAN&quot; else &quot;ADD_REVIEW_NOTE&quot;, target:&quot;SYNTHETIC_SECOND_LINE_TICKET&quot;, binding_status:&quot;GAP&quot;, execution_mode:&quot;ADVISORY_ONLY&quot;}]</text></literalExpression></decision>
</definitions>
