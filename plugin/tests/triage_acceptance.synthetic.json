{
 "schema": "dmn-json.decision-table/v1",
 "table": "triage.acceptance",
 "owner": {
  "app_id": "0f34962a-e380-45e1-8b35-fc64b5651776",
  "team": "TRIAGE",
  "name": "Synthetic token classifier"
 },
 "model_ref": "triage.acceptance@0.1.0",
 "model": {
  "profile": "service-decision-table-v1",
  "version": "0.1.0",
  "hit_policy": "UNIQUE",
  "parameters": {
   "scene_id": {
    "type": "string",
    "record_required": true,
    "nullable": false,
    "allowed_quality": [
     "KNOWN"
    ]
   },
   "synthetic.token_count": {
    "type": "integer",
    "record_required": false,
    "nullable": false,
    "allowed_quality": [
     "KNOWN",
     "UNKNOWN"
    ]
   }
  },
  "rules": [
   {
    "rule_id": "toy-low",
    "when": [
     {
      "path": [
       "parameters",
       "scene_id",
       "value"
      ],
      "op": "eq",
      "value": "P_99_81_01"
     },
     {
      "path": [
       "parameters",
       "synthetic.token_count",
       "value"
      ],
      "op": "lt",
      "value": 4
     }
    ],
    "output_template_ref": "ACCEPT"
   },
   {
    "rule_id": "toy-high",
    "when": [
     {
      "path": [
       "parameters",
       "scene_id",
       "value"
      ],
      "op": "eq",
      "value": "P_99_81_01"
     },
     {
      "path": [
       "parameters",
       "synthetic.token_count",
       "value"
      ],
      "op": "gte",
      "value": 4
     }
    ],
    "output_template_ref": "REJECT"
   },
   {
    "rule_id": "toy-exact",
    "when": [
     {
      "path": [
       "parameters",
       "scene_id",
       "value"
      ],
      "op": "eq",
      "value": "P_99_81_02"
     },
     {
      "path": [
       "parameters",
       "synthetic.token_count",
       "value"
      ],
      "op": "eq",
      "value": 9
     }
    ],
    "output_template_ref": "ACCEPT"
   },
   {
    "rule_id": "toy-other",
    "when": [
     {
      "path": [
       "parameters",
       "scene_id",
       "value"
      ],
      "op": "eq",
      "value": "P_99_81_02"
     },
     {
      "path": [
       "parameters",
       "synthetic.token_count",
       "value"
      ],
      "op": "ne",
      "value": 9
     }
    ],
    "output_template_ref": "REJECT"
   }
  ],
  "result_templates": {
   "ACCEPT": {
    "state": "ACCEPTED",
    "data": {
     "acceptance": {
      "literal": "ACCEPTED"
     },
     "basis": {
      "literal": "TOY_MATCH"
     }
    },
    "actions": []
   },
   "REJECT": {
    "state": "NOT_ACCEPTED",
    "data": {
     "acceptance": {
      "literal": "NOT_ACCEPTED"
     },
     "basis": {
      "literal": "TOY_OTHER"
     }
    },
    "actions": []
   },
   "NO_ROW": {
    "state": "ACCEPTED",
    "data": {
     "acceptance": {
      "literal": "ACCEPTED"
     },
     "basis": {
      "literal": "TOY_DEFAULT"
     }
    },
    "actions": []
   }
  },
  "on_no_match": "RESULT_TEMPLATE",
  "empty_template_ref": "NO_ROW"
 },
 "note": "Independently authored token-count toy: low-count and exact-count classification, not a business policy or captured evaluation."
}
