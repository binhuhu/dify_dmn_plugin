          "when": [
            {
              "path": [
                "parameters",
                "met_driver",
                "quality"
              ],
              "op": "eq",
              "value": "KNOWN"
            },
            {
              "path": [
                "parameters",
                "met_driver",
                "value"
              ],
              "op": "eq",
              "value": true
            }
          ],
          "output_template_ref": "auth"
        },
        {
          "rule_id": "not_met_ready",
          "when": [
            {
              "path": [
                "parameters",
                "met_driver",
                "quality"
              ],
              "op": "eq",
              "value": "KNOWN"
            },
            {
              "path": [
                "parameters",
                "met_driver",
                "value"
              ],
              "op": "eq",
              "value": false
            },
            {
              "path": [
                "parameters",
                "other_information_complete",
                "value"
              ],
              "op": "eq",
              "value": true
            }
          ],
          "output_template_ref": "ready"
        },
        {
          "rule_id": "not_met_other_gap",
          "when": [
            {
              "path": [
                "parameters",
                "met_driver",
                "quality"
              ],
              "op": "eq",
              "value": "KNOWN"
            },
            {
              "path": [
                "parameters",
                "met_driver",
                "value"
              ],
              "op": "eq",
              "value": false
            },
            {
              "path": [
                "parameters",
                "other_information_complete",
                "value"
              ],
              "op": "eq",
              "value": false
            }
          ],
          "output_template_ref": "other"
        }
